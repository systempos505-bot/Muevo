# Configuracion de produccion para Hostinger (hosting compartido).
#
# Copia este archivo al servidor como ~/muevo/.env y llena los valores
# marcados con CAMBIAR. El archivo .env nunca debe quedar dentro de
# public_html: ahi seria accesible desde el navegador.

APP_NAME=Muevo
APP_ENV=production

# Se genera en el servidor con:  php artisan key:generate
# Sin esta llave las sesiones y las contrasenas no funcionan.
APP_KEY=

# En false SIEMPRE en produccion. En true, cualquier error le muestra al
# usuario el codigo fuente, las rutas del servidor y la configuracion.
APP_DEBUG=false

# CAMBIAR por tu dominio real, con https si tienes el certificado activo.
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# En produccion solo interesan los errores. Con debug el log crece sin
# control y en hosting compartido el espacio es limitado.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de datos -------------------------------------------------
# Los cuatro valores salen de hPanel > Bases de datos > MySQL.
# Hostinger antepone tu usuario al nombre, algo como u123456789_muevo.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIAR_nombre_de_la_base
DB_USERNAME=CAMBIAR_usuario
DB_PASSWORD=CAMBIAR_contrasena

# --- Sesion, cache y colas -----------------------------------------
# Todo sobre base de datos: en hosting compartido no hay Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# 'sync' y no 'database' a proposito: en hosting compartido no hay un
# worker corriendo. Con 'database' cualquier tarea encolada se quedaria
# esperando para siempre sin que nadie la ejecute. Con 'sync' se ejecuta
# en el momento. Hoy el sistema no encola nada, asi que no cambia el
# comportamiento, pero evita una sorpresa el dia que algo se encole.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo ---------------------------------------------------------
# Hace falta para recuperar contrasenas. Con 'log' los correos se
# escriben en un archivo y nunca llegan a nadie.
#
# En hPanel > Correos > Cuentas de correo crea una cuenta y usa esos
# datos. El host de Hostinger suele ser smtp.hostinger.com.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=CAMBIAR_correo@tudominio.com
MAIL_PASSWORD=CAMBIAR_contrasena_del_correo
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=CAMBIAR_correo@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
